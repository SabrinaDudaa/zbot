# Copie este arquivo para ".env" e preencha. Nunca publique o .env.

# Obrigatórias
DISCORD_TOKEN=
CLIENT_ID=
CANAL_PROMOCOES_ID=

# Opcionais
# ID do servidor: o comando aparece na hora
GUILD_ID=
# Chave gratuita em https://isthereanydeal.com/apps/my/ (preços reais em R$ e Nuuvem)
ITAD_API_KEY=
# Desconto mínimo (%) para postar
DESCONTO_MINIMO=20
# Só posta jogos entre os N mais populares do ITAD (0 desliga o filtro).
# Menor = só jogos mais famosos; maior = mais variedade. Precisa da ITAD_API_KEY.
POPULARIDADE_TOP=2000
# Máximo de promoções por verificação
MAX_POR_CICLO=15
# Frequência da verificação (padrão: a cada 6 horas)
CRON=0 */6 * * *
# Animes novos (opcional): ID do canal onde avisar episódios novos. Sem isso, o recurso fica desligado.
CANAL_ANIMES_ID=
# Só avisa animes com pelo menos N pessoas com ele na lista do AniList (maior = só os mais famosos)
ANIME_POPULARIDADE_MIN=10000
# Frequência da verificação de animes (padrão: a cada 30 minutos)
CRON_ANIMES=*/30 * * * *
