# Copie este arquivo para ".env" e preencha. Nunca publique o .env.

# Obrigatórias
DISCORD_TOKEN=
CLIENT_ID=
CANAL_PROMOCOES_ID=

# Opcionais
# ID do servidor: o comando aparece na hora
GUILD_ID=
# Chave gratuita em https://isthereanydeal.com/apps/my/ (preços reais em R$ e Nuuvem)
ITAD_API_KEY=
# Desconto mínimo (%) para postar
DESCONTO_MINIMO=20
# Máximo de promoções por verificação
MAX_POR_CICLO=15
# Frequência da verificação (padrão: a cada 6 horas)
CRON=0 */6 * * *
